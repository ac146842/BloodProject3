@model BloodProject3.Models.Nurse

@{
    ViewData["Title"] = "Edit";
}
<div class="edit-header">
    <div>
        <h1>Edit</h1>
        <h3>Nurse</h3>
    </div>
</div>
<div class="row">
    <div class="edit-boxes col-md-4">
        <form id="editForm" asp-action="Edit" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NurseID" />

            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="JobRole" class="control-label"></label>
                <input asp-for="JobRole" class="form-control" />
                <span asp-validation-for="JobRole" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EmployedStartDate" class="control-label"></label>
                <input asp-for="EmployedStartDate" class="form-control" />
                <span asp-validation-for="EmployedStartDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LicenseNumber" class="control-label"></label>
                <input asp-for="LicenseNumber" class="form-control" />
                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
            </div>

            <div class="edit-actions">
                <button type="submit" form="editForm" class="btn btn-dark btn-outline-secondary">Save</button>
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}