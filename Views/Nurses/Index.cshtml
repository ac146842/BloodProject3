@model IEnumerable<BloodProject3.Models.Nurse>

@{
    ViewData["Title"] = "Nurses";
}

<h1 class="table-header">Nurses</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobRole)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmployedStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LicenseNumber)
            </th>
            
            <th class="text-end py-2">
                <a asp-action="Create" class="btn btn-dark btn-outline-secondary">+ Create New</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JobRole)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployedStartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LicenseNumber)
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.NurseID" class="btn btn-dark btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.NurseID" class="btn btn-dark btn-outline-secondary">Details</a>

                    <a href="#delete-modal-@item.NurseID" class="btn btn-dark btn-outline-danger">Delete</a>

                    <div id="delete-modal-@item.NurseID" class="css-modal-overlay text-start">
                        <div class="custom-modal">
                            <div class="custom-modal-body">
                                <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                            </div>
                            <div class="custom-modal-actions">
                                <a href="#" class="btn-modal-cancel">Cancel</a>
                                <a asp-action="Delete" asp-route-id="@item.NurseID" class="btn-modal-delete">Delete</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>