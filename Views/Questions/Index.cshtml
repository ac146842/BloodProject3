@model IEnumerable<BloodProject3.Models.Questions>

@{
    ViewData["Title"] = "Questions";
}

<h1 class="table-header">Questions</h1>

<p class="btn-create">
    <a asp-action="Create" class="btn btn-dark">Create</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FormQuestions)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FormQuestions)
            </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.HealthQID" class="btn btn-dark">Edit</a> 
                    <a asp-action="Details" asp-route-id="@item.HealthQID" class="btn btn-dark">Details</a> 
                    <a asp-action="Delete" asp-route-id="@item.HealthQID" class="btn btn-dark">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
