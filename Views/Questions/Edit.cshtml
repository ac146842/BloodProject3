@model BloodProject3.Models.Questions

@{
    ViewData["Title"] = "Edit";
}
<div class="edit-header">
    <div>
        <h1>Edit</h1>
        <h3>Questions</h3>
    </div>

    <div class="edit-actions">
        <button type="submit" form="editForm" class="btn-save">Save</button>
        <a asp-action="Index" class="btn-back">Back to List</a>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <form id="editForm" asp-action="Edit" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HealthQID" />

            <div class="form-group">
                <label asp-for="FormQuestions" class="control-label"></label>
                <input asp-for="FormQuestions" class="form-control" />
                <span asp-validation-for="FormQuestions" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}