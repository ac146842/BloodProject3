@model BloodProject3.Models.MedicalForm

@{
    ViewData["Title"] = "Create Medical Form";
}
<div class="create-header">
    <h1>Create page for Medical Form</h1>
</div>
<div class="row">
    <div class="create-boxes col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NurseID" class="control-label">Select Nurse</label>
                <select asp-for="NurseID" class="form-control" asp-items="ViewBag.NurseList">
                    <option value="">-- Select a Nurse --</option>
                </select>
                <span asp-validation-for="NurseID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AppointmentID" class="control-label"></label>
                <input asp-for="AppointmentID" class="form-control" />
                <span asp-validation-for="AppointmentID" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="FormDate" class="control-label"></label>
                <input asp-for="FormDate"
                       class="form-control"
                       type="datetime-local"
                       max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FormDate" class="text-danger"></span>
            </div>

            <div class="create-actions">
                <input type="submit" value="Create" class="btn btn-dark btn-outline-secondary" />
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}