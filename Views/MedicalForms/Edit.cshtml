@model BloodProject3.Models.MedicalForm

@{
    ViewData["Title"] = "Edit Medical Form";
}
<div class="edit-header">
    <h1>Edit details for Medical Form</h1>
</div>
<div class="row">
    <div class="edit-boxes col-md-4">
        <form id="editForm" asp-action="Edit" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FormID" />

            <div class="form-group">
                <label asp-for="NurseID" class="control-label">Nurse</label>
                <select asp-for="NurseID" class="form-control" asp-items="ViewBag.NurseList">
                    <option value="">-- Select Nurse --</option>
                </select>
                <span asp-validation-for="NurseID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AppointmentID" class="control-label">Appointment</label>
                <select asp-for="AppointmentID" class="form-control" asp-items="ViewBag.AppointmentList">
                    <option value="">-- Select Appointment --</option>
                </select>
                <span asp-validation-for="AppointmentID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FormDate" class="control-label"></label>
                <input asp-for="FormDate"
                       class="form-control"
                       type="datetime-local"
                       max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FormDate" class="text-danger"></span>
            </div>

            <div class="edit-actions">
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
                <button type="submit" form="editForm" class="btn btn-dark btn-outline-secondary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}