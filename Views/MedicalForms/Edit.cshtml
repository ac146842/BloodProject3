@model BloodProject3.Models.MedicalForm

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MedicalForm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FormID" />
            <div class="form-group">
                <label asp-for="NurseID" class="control-label"></label>
                <input asp-for="NurseID" class="form-control" />
                <span asp-validation-for="NurseID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AppointmentID" class="control-label"></label>
                <input asp-for="AppointmentID" class="form-control" />
                <span asp-validation-for="AppointmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FormDate" class="control-label"></label>
                <input asp-for="FormDate" class="form-control" />
                <span asp-validation-for="FormDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
