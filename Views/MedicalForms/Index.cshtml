@model IEnumerable<BloodProject3.Models.MedicalForm>

@{
    ViewData["Title"] = "Medical Forms";
}

<h1 class="table-header">Medical Forms</h1>

<p class="btn-create">
    <a asp-action="Create" class="btn btn-dark">Create</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>FormID</th>
            <th>Nurse Name</th>
            <th>Appointment Details</th>
            <th>@Html.DisplayNameFor(model => model.FormDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.FormID
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nurse.FirstName)
                    @Html.DisplayFor(modelItem => item.Nurse.LastName)
                </td>
                <td>
                    @item.Appointment.Donor.FirstName @item.Appointment.Donor.LastName
                    (@item.Appointment.AppointmentDateTime.ToString("dd/MM/yyyy"))
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FormDate)
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.FormID" class="btn btn-dark">Edit</a> 
                    <a asp-action="Details" asp-route-id="@item.FormID" class="btn btn-dark">Details</a> 
                    <a asp-action="Delete" asp-route-id="@item.FormID" class="btn btn-dark">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>