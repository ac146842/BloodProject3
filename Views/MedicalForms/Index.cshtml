@model IEnumerable<BloodProject3.Models.MedicalForm>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>FormID</th>
            <th>Nurse Name</th>
            <th>Appointment Details</th>
            <th>@Html.DisplayNameFor(model => model.FormDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.FormID
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nurse.FirstName)
                    @Html.DisplayFor(modelItem => item.Nurse.LastName)
                </td>
                <td>
                    @item.Appointment.Donor.FirstName @item.Appointment.Donor.LastName
                    (@item.Appointment.AppointmentDateTime.ToString("dd/MM/yyyy"))
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FormDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.FormID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.FormID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.FormID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>