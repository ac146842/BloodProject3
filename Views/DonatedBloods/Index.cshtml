@model IEnumerable<BloodProject3.Models.DonatedBlood>

@{
    ViewData["Title"] = "Donated Blood";
}

<h1 class="table-header">Donated Blood</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Appointment Details</th>
            <th>Blood Type</th>
            <th>Donor Name</th>
            <th>@Html.DisplayNameFor(model => model.CollectionDate)</th>
            <th>@Html.DisplayNameFor(model => model.VolumeML)</th>
            <th>@Html.DisplayNameFor(model => model.ExpiryDate)</th>
            <th>@Html.DisplayNameFor(model => model.BloodStatus)</th>
            
            <th class="text-end py-2">
                <a asp-action="Create" class="btn btn-dark btn-outline-secondary">+ Create New</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Appointment != null)
                    {
                        @item.Appointment.AppointmentDateTime.ToString("hh:mm tt")
                        <small class="text-dark">@item.Appointment.Location</small>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">No Match Found for ID: @item.AppointmentID</span>
                    }
                </td>
                <td>
                    @if (item.BloodType != null)
                    {
                        @item.BloodType.SelectedBloodType.ToString()
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </td>
                <td>
                    @if (item.Donor != null)
                    {
                        @Html.DisplayFor(modelItem => item.Donor.FullName)
                    }
                    else
                    {
                        <span class="text-muted">Unknown Donor</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.CollectionDate)</td>
                <td>@Html.DisplayFor(modelItem => item.VolumeML)</td>
                <td>@Html.DisplayFor(modelItem => item.ExpiryDate)</td>
                <td>@Html.DisplayFor(modelItem => item.BloodStatus)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.DonationID" class="btn btn-dark btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.DonationID" class="btn btn-dark btn-outline-secondary">Details</a>

                    <a href="#delete-modal-@item.DonationID" class="btn btn-dark btn-outline-danger">Delete</a>

                    <div id="delete-modal-@item.DonationID" class="css-modal-overlay text-start">
                        <div class="custom-modal">
                            <div class="custom-modal-body">
                                <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                            </div>
                            <div class="custom-modal-actions">
                                <a href="#" class="btn-modal-cancel">Cancel</a>
                                <a asp-action="Delete" asp-route-id="@item.DonationID" class="btn-modal-delete">Delete</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>