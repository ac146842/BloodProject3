<style>  
    .header-container {
        display: flex;
        flex-direction: column;

    }

    .Header1 {
        font-size: 2.5rem;
        color: #212529;
        text-align: left;

        
    }

    .DonationP {
        font-size: 1.2rem;
        color: #212529;
        text-align: left;
        max-width: 100ch;
    }   
</style>

@{
    ViewData["Title"] = "Home Page";
}

<div class="header-container">
    <div>
        <h1 class="Header1">
            Welcome to the Blood Donation App!
        </h1>
    </div>

    <div>
        <p class="DonationP">
            Every drop of blood goes towards someone in need.
            Blood cannot be synthetically made, and patients rely
            entirely on donors for everything ranging from surgeries
            to blood disorders. By donating, you provide doctors to
            help patients and individuals a second chance at life.
            A single donation takes less than an hour but can save up
            to three lives!
        </p>
    </div>
</div>


