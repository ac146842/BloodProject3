@model IEnumerable<BloodProject3.Models.Donor>

@{
    ViewData["Title"] = "Donors";
}

<h1 class="table-header">Donors</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BloodType.SelectedBloodType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastDonationDate)
            </th>
            
            <th class="text-end py-2">
                <a asp-action="Create" class="btn btn-dark btn-outline-secondary">+ Create New</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateOfBirth)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BloodType.SelectedBloodType)
                </td>
                <td>
                    @{
                        var lastDonation = item.DonatedBloods?
                            .Where(d => d.BloodStatus == DonatedBlood.Status.Approved)
                            .OrderByDescending(d => d.CollectionDate)
                            .Select(d => d.CollectionDate)
                            .FirstOrDefault();

                        if (lastDonation != null && lastDonation != DateTime.MinValue)
                        {
                            @lastDonation.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">No donations yet</span>
                        }
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.DonorID" class="btn btn-dark btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.DonorID" class="btn btn-dark btn-outline-secondary">Details</a>

                    <a href="#delete-modal-@item.DonorID" class="btn btn-dark btn-outline-danger">Delete</a>

                    <div id="delete-modal-@item.DonorID" class="css-modal-overlay text-start">
                        <div class="custom-modal">
                            <div class="custom-modal-body">
                                <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                            </div>
                            <div class="custom-modal-actions">
                                <a href="#" class="btn-modal-cancel">Cancel</a>
                                <a asp-action="Delete" asp-route-id="@item.DonorID" class="btn-modal-delete">Delete</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>