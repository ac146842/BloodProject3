@model BloodProject3.Models.Inventory

@{
    ViewData["Title"] = "Create Inventory";
}
<div class="create-header">
    <h1>Create page for Inventory</h1>
</div>
<div class="row">
    <div class="create-boxes col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DonationID" class="control-label"></label>
                <input asp-for="DonationID" class="form-control" />
                <span asp-validation-for="DonationID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BloodTypeID" class="control-label">Blood Type</label>
                <select asp-for="BloodTypeID" class="form-control" asp-items="ViewBag.BloodTypeID"></select>
                <span asp-validation-for="BloodTypeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrentVolumeML" class="control-label"></label>
                <input asp-for="CurrentVolumeML" class="form-control" />
                <span asp-validation-for="CurrentVolumeML" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StorageLocation" class="control-label"></label>
                <input asp-for="StorageLocation" class="form-control" />
                <span asp-validation-for="StorageLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BloodStatus" class="control-label"></label>
                <select asp-for="BloodStatus" class="form-control" asp-items="Html.GetEnumSelectList<Inventory.Status>()"></select>
                <span asp-validation-for="BloodStatus" class="text-danger"></span>
            </div>

            <div class="create-actions">
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
                <input type="submit" value="Create" class="btn btn-dark btn-outline-secondary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}