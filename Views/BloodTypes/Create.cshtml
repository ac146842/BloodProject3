@model BloodProject3.Models.BloodType

@{
    ViewData["Title"] = "Create Blood Types";
}
<div class="create-header">
    <h1>Create page for Blood Types</h1>
</div>
<div class="row">
    <div class="create-boxes col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SelectedBloodType" class="control-label"></label>
                <input asp-for="SelectedBloodType" class="form-control" placeholder="Enter Blood Type" />
                <span asp-validation-for="SelectedBloodType" class="text-danger"></span>
            </div>

            <div class="create-actions">
                <input type="submit" value="Create" class="btn btn-dark btn-outline-secondary" />
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}