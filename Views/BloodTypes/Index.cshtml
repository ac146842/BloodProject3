@model IEnumerable<BloodProject3.Models.BloodType>

@{
    ViewData["Title"] = "Blood Types";
}

<h1 class="table-header">Blood Types</h1>

<p class="btn-create">
    <a asp-action="Create" class="btn btn-dark">Create</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SelectedBloodType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SelectedBloodType)
            </td>
                <td class="text-end">
                    <a asp-action="Delete" asp-route-id="@item.BloodTypeID" class="btn btn-dark">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
