@model BloodProject3.Models.Answers

@{
    ViewData["Title"] = "Edit";
}


<div class="edit-header">
    <div>
        <h1>Edit</h1>
        <h3>Answers</h3>
    </div>

    <div class="edit-actions">
        <button type="submit" form="editForm" class="btn-save">Save</button>
        <a asp-action="Index" class="btn-back">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <form id="editForm" asp-action="Edit" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AnswersID" />

            <div class="form-group">
                <label asp-for="FormID" class="control-label"></label>
                <input asp-for="FormID" class="form-control" />
                <span asp-validation-for="FormID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HealthQID" class="control-label"></label>
                <select asp-for="HealthQID" class="form-control" asp-items="ViewBag.HealthQID"></select>
                <span asp-validation-for="HealthQID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DonorID" class="control-label"></label>
                <input asp-for="DonorID" class="form-control" />
                <span asp-validation-for="DonorID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AnswersText" class="control-label"></label>
                <input asp-for="AnswersText" class="form-control" />
                <span asp-validation-for="AnswersText" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AnswerDate" class="control-label"></label>
                <input asp-for="AnswerDate" class="form-control" />
                <span asp-validation-for="AnswerDate" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}