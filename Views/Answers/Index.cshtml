@model IEnumerable<BloodProject3.Models.Answers>

@{
    ViewData["Title"] = "Answers";
}

<!-- . -->

<!--                <th>
                        @Html.DisplayNameFor(model => model.FormID)
                    </th> 
-->

<h1 class="index-header">Answers</h1>

<div class="index-card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="p-0">

        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]">@Html.DisplayNameFor(model => model.FormID)</a>
                    </th>

                    
                    <th>
                        @Html.DisplayNameFor(model => model.Questions)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Donor)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswersText)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerDate)
                    </th>
                    <th class="text-end">
                        <a asp-action="Create" class="btn btn-dark btn-outline-secondary">+ Create New</a>
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FormID)
                        </td>
                        <td>
                            @(item.Questions != null && !string.IsNullOrEmpty(item.Questions.FormQuestions)
                                ? (item.Questions.FormQuestions.Length > 40
                                    ? item.Questions.FormQuestions.Substring(0, 40) + "..."
                                    : item.Questions.FormQuestions)
                                : item.HealthQID)
                        </td>
                        <td>
                            @(item.Donor != null && !string.IsNullOrEmpty(item.Donor.FirstName) && !string.IsNullOrEmpty(item.Donor.LastName)
                                ? $"{item.Donor.FirstName} {item.Donor.LastName[0]}."
                                : item.DonorID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswersText)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerDate)
                        </td>

                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.AnswersID" class="btn btn-dark btn-outline-secondary">Edit</a>

                            <a href="#delete-modal-@item.AnswersID" class="btn btn-dark btn-outline-danger">Delete</a>

                            <div id="delete-modal-@item.AnswersID" class="css-modal-overlay text-start">
                                <div class="custom-modal">
                                    <div class="custom-modal-body">
                                        <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                                    </div>
                                    <div class="custom-modal-actions">
                                        <a href="#" class="btn-modal-cancel">Cancel</a>
                                        <a asp-action="Delete" asp-route-id="@item.AnswersID" class="btn-modal-delete">Delete</a>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           class="btn btn-default @prevDisabled">
            Previous
        </a>
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           class="btn btn-default @nextDisabled">
            Next
        </a>

    </div>
</div>