@model IEnumerable<BloodProject3.Models.Answers>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<p><a asp-action="Create">Create New</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Donor</th>
            <th>Answer</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Donor.FirstName @item.Donor.LastName</td>
                <td>@(item.AnswersBool ? "Yes" : "No")</td>
                <td>@item.AnswerDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AnswersID">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.AnswersID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>