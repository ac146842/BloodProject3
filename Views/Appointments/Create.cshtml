@model BloodProject3.Models.Appointment

@{
    ViewData["Title"] = "Create Appointments";
}
<div class="create-header">
    <h1>Create page for Appointments</h1>
</div>
<div class="row">
    <div class="create-boxes col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DonorID" class="control-label">Donor</label>
                <select asp-for="DonorID" class="form-control" asp-items="ViewBag.DonorList">
                    <option value="">-- Select Donor --</option>
                </select>
                <span asp-validation-for="DonorID" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="AppointmentDateTime" class="control-label"></label>
                <input asp-for="AppointmentDateTime"
                       type="datetime-local"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                       class="form-control" />
                <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AppointmentStatus" class="control-label"></label>
                <select asp-for="AppointmentStatus" class="form-control" asp-items="Html.GetEnumSelectList<Appointment.Status>()"></select>
                <span asp-validation-for="AppointmentStatus" class="text-danger"></span>
            </div>

            <div class="create-actions">
                <input type="submit" value="Create" class="btn btn-dark btn-outline-secondary" />
                <a asp-action="Index" class="btn btn-dark btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}