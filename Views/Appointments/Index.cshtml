@model IEnumerable<BloodProject3.Models.Appointment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<p><a asp-action="Create">Create New</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Donor Name</th>
            <th>Nurse Name</th>
            <th>@Html.DisplayNameFor(model => model.AppointmentDateTime)</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>@Html.DisplayNameFor(model => model.TypeOfAppointment)</th>
            <th>@Html.DisplayNameFor(model => model.AppointmentStatus)</th>
            <th>@Html.DisplayNameFor(model => model.DurationEndTime)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Donor.FirstName) @Html.DisplayFor(modelItem => item.Donor.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nurse.FirstName) @Html.DisplayFor(modelItem => item.Nurse.LastName)
                </td>
                <td>@Html.DisplayFor(modelItem => item.AppointmentDateTime)</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@Html.DisplayFor(modelItem => item.TypeOfAppointment)</td>
                <td>@Html.DisplayFor(modelItem => item.AppointmentStatus)</td>
                <td>@Html.DisplayFor(modelItem => item.DurationEndTime)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AppointmentID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.AppointmentID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.AppointmentID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>