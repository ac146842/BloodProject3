@model IEnumerable<BloodProject3.Models.Appointment>

@{
    ViewData["Title"] = "Appointments Index";
}

<h1>Appointments</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Appointment Time</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>Donor Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.AppointmentDateTime.ToString("hh:mm tt")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @if (item.Donor != null)
                    {
                        @Html.DisplayFor(modelItem => item.Donor.FullName)
                    }
                    else
                    {
                        <span class="text-muted">No Donor Assigned</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AppointmentID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.AppointmentID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.AppointmentID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>