@model BloodProject3.Views.PaginatedList<BloodProject3.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}
<div>
    <h1 class="index-header">Appointments</h1>

    <div class="search-form-container">
        <form asp-action="Index" method="get">
            <div class="searchWrapper">
                <div>
                    <a asp-action="Index" class="label">SHOW FULL LIST</a>
                </div>
                <div>
                    <input id="searchInput" type="text" name="SearchString" value="@ViewData["CurrentFilter"]" placeholder="Press enter to search" class="search" />
                </div>
            </div>
        </form>
    </div>
</div>
<div class="index-card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="p-0">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>Appointment ID</th>
                    <th>Appointment Date&Time</th>
                    <th>Type of appointment</th>
                    <th>Location</th>
                    <th>Donor</th>
                    <th>Appointment Status</th>
                    <th class="text-end py-2">
                        <a asp-action="Create" class="btn btn-dark btn-outline-secondary" style="max-height: 38px !important; white-space: nowrap !important; height: auto !important;">+ Create New</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.AppointmentID)
                        </td>
                        <td>
                            @item.AppointmentDateTime.ToString("dd/MM/yyyy hh:mm tt")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TypeOfAppointment)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Location)
                        </td>
                        <td>
                            @if (item.Donor != null)
                            {
                                @Html.DisplayFor(modelItem => item.Donor.FullName)
                            }
                            else
                            {
                                <span class="text-muted">No Donor Assigned</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AppointmentStatus)
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.AppointmentID" class="btn btn-dark btn-outline-secondary">Edit</a>

                            <a href="#delete-modal-@item.AppointmentID" class="btn btn-dark btn-outline-danger">Delete</a>

                            <div id="delete-modal-@item.AppointmentID" class="css-modal-overlay text-start">
                                <div class="custom-modal">
                                    <div class="custom-modal-body">
                                        <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                                    </div>
                                    <div class="custom-modal-actions">
                                        <a href="#" class="btn-modal-cancel">Cancel</a>
                                        <form asp-action="Delete" asp-route-id="@item.AppointmentID" method="post" style="flex: 1; display: flex; margin: 0;">
                                            <button type="submit" class="btn-modal-delete" style="width: 100%;">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        @i
                    </a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>
</div>