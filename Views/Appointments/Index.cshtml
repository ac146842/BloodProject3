@model IEnumerable<BloodProject3.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<h1 class="table-header">Appointments</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Appointment Time</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>Donor Name</th>

            <th class="text-end py-2">
                <a asp-action="Create" class="btn btn-dark btn-outline-secondary">+ Create New</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.AppointmentDateTime.ToString("hh:mm tt")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @if (item.Donor != null)
                    {
                        @Html.DisplayFor(modelItem => item.Donor.FullName)
                    }
                    else
                    {
                        <span class="text-muted">No Donor Assigned</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.AppointmentID" class="btn btn-dark btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.AppointmentID" class="btn btn-dark btn-outline-secondary">Details</a>

                    <a href="#delete-modal-@item.AppointmentID" class="btn btn-dark btn-outline-danger">Delete</a>

                    <div id="delete-modal-@item.AppointmentID" class="css-modal-overlay text-start">
                        <div class="custom-modal">
                            <div class="custom-modal-body">
                                <p class="text-muted fw-semibold small mb-0 text-center">Are you sure you want to delete this record?</p>
                            </div>
                            <div class="custom-modal-actions">
                                <a href="#" class="btn-modal-cancel">Cancel</a>
                                <a asp-action="Delete" asp-route-id="@item.AppointmentID" class="btn-modal-delete">Delete</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>