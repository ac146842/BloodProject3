@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login">
    <h1 class="login-title">Login</h1>
    <p class="login-text">Please enter your details to sign in</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-boxes">
            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control round" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control round" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button id="login-submit" type="submit" class="btn btn-login round">Login</button>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-register round">Register</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    #account {
        width: 100%;
    }

    .login {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        max-width: 400px;
        margin: 60px auto;
        text-align: center;
        font-family: sans-serif;
        min-height: 80vh;
    }

    .login-title {
        color: #6C4A60;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .login-text {
        color: #5A6A85;
        font-size: 0.95rem;
        margin-bottom: 25px;
        font-weight: 500;
    }

    .form-boxes {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .round {
        border-radius: 50px !important;
        padding: 12px 24px !important;
        height: 50px !important;
    }

    .btn-login {
        background-color: #E9444E !important;
        color: white !important;
        height: 50px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
    }

    .btn-register {
        background-color: #333E48 !important;
        color: white !important;
        height: 50px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
    }
</style>